    <element xsi:type="archimate:ApplicationComponent" name="Historia Clínica (HCE)" id="id-045e36d02f8a43af94cc7975155f4dac"/>
    <element xsi:type="archimate:ApplicationComponent" name="Programación Quirúrgica" id="id-b8f5db9887ac43cfb71079b151561f42"/>

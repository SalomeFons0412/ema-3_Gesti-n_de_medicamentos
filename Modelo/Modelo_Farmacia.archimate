    <element xsi:type="archimate:TechnologyFunction" name="Technology Function" id="id-914f869e199a4ae09e3c1af243f6e397"/>
  </folder>
  <folder name="Motivation" id="id-1899658c54124f5387ba07fb2c3692d4" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="ST-03 Área de compras" id="id-d02d930ffe7b4eaf830247cc62ea9fdc"/>
    <element xsi:type="archimate:Driver" name="DR-01 Perdidas económicas por vencimiento de medicamentos" id="id-e4a352bbf00f441aabbad6d506d79e82"/>
    <element xsi:type="archimate:Stakeholder" name="ST-05 Contabilidad y auditoría" id="id-49ac13a16e5f44e388e65d8f81218a28"/>
    <element xsi:type="archimate:Stakeholder" name="ST-01 Dirección del hospital" id="id-fc1dea0043ff40dca0e172023c9c18a3"/>
    <element xsi:type="archimate:Stakeholder" name="ST-04 Servicios asistenciales" id="id-b3f8aad2a0644955b363d344005ae0f8"/>
    <element xsi:type="archimate:Stakeholder" name="ST-02 Farmacia hospitalaria" id="id-13a314d8e1644d2ba70ccf09a8a28986"/>
    <element xsi:type="archimate:Driver" name="DR-02 Incertidumbre de la demanda hospitalaria" id="id-77301b5f404c42e5b815ba93ef014d29"/>
    <element xsi:type="archimate:Driver" name="DR-03 Necesidad de disponibilidad oportuna de medicamentos" id="id-cde6edce3503406ba82c3d5a7d180361"/>
    <element xsi:type="archimate:Driver" name="DR-04 Necesidad de trazabilidad del inventario" id="id-d18f783c0b1a401291297e6a03ac82bc"/>
    <element xsi:type="archimate:Assessment" name="AS-01 Riesgo de vencimiento por falta de rotación oportuna" id="id-2ed07b2fad0a41a2ae5735a72705d67c"/>
    <element xsi:type="archimate:Assessment" name="AS-02 Dificultad para anticipar las necesidades de medicamentos" id="id-b8971ae8732b4e5189d2f8bddafa7cc2"/>
    <element xsi:type="archimate:Assessment" name="AS-03 Riesgo de diferencias entre inventario físico y registrado" id="id-97679200af6f49e883fb01fe01e93b5d"/>
    <element xsi:type="archimate:Assessment" name="AS-04 Dependencia de información de otros sistemas" id="id-1412fb5b0ffd4ea198be9cf0efc0ec5a"/>
    <element xsi:type="archimate:Goal" name="GO-01 Reducir las pérdidas por vencimiento" id="id-dfe6d2da129f47d68026746edaffb34d"/>
    <element xsi:type="archimate:Goal" name="GO-02 Mejorar la disponibilidad de medicamentos" id="id-5633d83db8c24707895aed53830edba9"/>
    <element xsi:type="archimate:Goal" name="GO-03 Anticipar las necesidades de abastecimiento" id="id-81469070ad8347f8b6ab87f0d04edb47"/>
    <element xsi:type="archimate:Goal" name="GO-04 Mejorar la trazabilidad del inventario" id="id-a6ceef406d7f4a5e9d3fd853e1eedbd2"/>
    <element xsi:type="archimate:Outcome" name="OU-01 Menor cantidad de medicamentos perdidos por vencimiento" id="id-3d7b57e5bee54ea7bcf4ec0fcbdad550"/>
    <element xsi:type="archimate:Outcome" name="OU-02 Mayor capacidad para anticipar faltantes" id="id-19869e3bf30749fa8c30ddab3877f5f0"/>
    <element xsi:type="archimate:Outcome" name="OU-03 Mejor visibilidad de las existencias utilizables por lote" id="id-334d09d9a8be42849b24f3178edec0df"/>
    <element xsi:type="archimate:Principle" name="PR-01 Trazabilidad del medicamento por lote y vencimiento" id="id-29a65d9085ed4caeba60772c78fe2c93"/>
    <element xsi:type="archimate:Principle" name="PR-03 Separar la recomendación automatizada de la autorización de compra" id="id-bf86f72e5c93409c86196193a8f6451c"/>
    <element xsi:type="archimate:Principle" name="PR-02 Priorizar medicamentos aptos según su fecha de vencimiento" id="id-87636fa304ed4c21be00de0029bdc3f1"/>
    <element xsi:type="archimate:Requirement" name="RE-01 Controlar el inventario por lote y fecha de vencimiento" id="id-bb4080bd08554690b775e747f6f9ceff"/>
    <element xsi:type="archimate:Requirement" name="RE-02 Generar alertas de medicamentos próximos a vencer" id="id-86766103046845dd8023a44a11654f81"/>
    <element xsi:type="archimate:Requirement" name="RE-04 Estimar la demanda con programación e histórico" id="id-c6b2c162176b4c1d9ea915a885d5f4e4"/>
    <element xsi:type="archimate:Requirement" name="RE-05 Generar requerimientos de compra de medicamentos" id="id-38284c2be5fa4b74a30017614ad64c41"/>
    <element xsi:type="archimate:Requirement" name="RE-03 Priorizar el uso según vencimiento y demanda próxima" id="id-57cb7b7329414f90ad40798ee4c9fa7b"/>
    <element xsi:type="archimate:Constraint" name="CO-01 Alcance centrado en gestión de medicamentos y reducción de pérdidas por vencimiento" id="id-ca0ba7f17c23452f93de7cd667076ce6"/>
    <element xsi:type="archimate:Constraint" name="CO-03 No asumir la gestión integral de compras fuera del alcance definido" id="id-75e6ebf61c534aeca68e117ab7646170"/>
    <element xsi:type="archimate:Constraint" name="CO-02 Considerar demanda programada y no programada" id="id-6f1ddd94e7164e10a85566d3d80858c1"/>
    <element xsi:type="archimate:Goal" name="Reducir las pérdidas por vencimiento de medicamentos mediante alertas oportunas, validación de restricciones y priorización de lotes aptos según FEFO." id="id-57bd060ee2c44ec6878e20b9c63af744"/>
    <element xsi:type="archimate:Constraint" name="Un lote vencido, bloqueado o en cuarentena no es apto para dispensación." id="id-357376a6687441dab564cc20f0263f94"/>
    <element xsi:type="archimate:Constraint" name="Una alerta de vencimiento no equivale por sí sola a una restricción de uso." id="id-6c47de8b31984f7b8fd18123a77b34a4"/>
    <element xsi:type="archimate:Constraint" name="No se generan alertas duplicadas mientras una alerta equivalente siga vigente." id="id-03ba52184e2f4a5aad28a10887039b8a"/>
    <element xsi:type="archimate:Requirement" name="Una actualización de estado que impida el uso debe comunicarse a los procesos consumidores." id="id-26046fa84bba45eea24c87af7e334fce"/>
    <element xsi:type="archimate:Requirement" name="Una alerta de vencimiento no equivale por sí sola a una restricción de uso." id="id-650beb2cb82c4aab9a22642a76a13e91"/>
    <element xsi:type="archimate:Requirement" name="La priorización FEFO solo se aplica a lotes aptos." id="id-6de7b7ec6f9241e5873c7c603b73c723"/>
    <element xsi:type="archimate:Goal" name="Oportunidad de alertas: porcentaje de lotes que alcanzan el umbral y reciben una alerta antes del vencimiento." id="id-440b47612ef54a2d940716596f14d809"/>
    <element xsi:type="archimate:Goal" name="Cumplimiento FEFO: porcentaje de dispensaciones elegibles que seleccionan el lote apto con vencimiento más próximo." id="id-16d2420bdc6846bb8e4816d527f1584a"/>
    <element xsi:type="archimate:Goal" name="Duplicidad de alertas: porcentaje de alertas generadas que duplican una alerta equivalente aún vigente." id="id-1eea6175bbd64823a02962b50e13169e"/>
    <element xsi:type="archimate:Goal" name="Oportunidad de alertas: porcentaje de lotes que alcanzan el umbral y reciben una alerta antes del vencimiento. (copy)" id="id-03c19565ae224a48a7d4278bde504009"/>
    <element xsi:type="archimate:Goal" name="Cumplimiento FEFO: porcentaje de dispensaciones elegibles que seleccionan el lote apto con vencimiento más próximo. (copy)" id="id-f5dcb60f640a4685b69de5cacf64e8a0"/>
    <element xsi:type="archimate:Goal" name="Duplicidad de alertas: porcentaje de alertas generadas que duplican una alerta equivalente aún vigente. (copy)" id="id-fca4e6d1060c4587bc3c6cdcff33b05b"/>
    <element xsi:type="archimate:Meaning" name="Primero en expirar, primero en salir. Regla innegociable de uso" id="id-10d3e8b49f8548508ca1120cd4ec8b90"/>
    <element xsi:type="archimate:Meaning" name="Estado de bloqueo temporal en sistema por fallo físico o alerta" id="id-4512ff09dd534a9582eb0619ecbf8628"/>
    <element xsi:type="archimate:Meaning" name="Medicamento dispensado por paciente para 24 horas" id="id-6fffa25f55584cd4a4035b789bebd15f"/>
    <element xsi:type="archimate:Meaning" name="Verificación física y técnica de lotes y vencimientos al ingreso" id="id-2b005e857abb4668af83ab5540e4abc1"/>
    <element xsi:type="archimate:Meaning" name="Kit de medicamentos preparado y validado para una cirugía" id="id-6ab15d9085cf463e8a7335bf0f699abf"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-cb2b9b3ce01a4319bcf32a13d1bbe0ba" type="implementation_migration"/>

    <element xsi:type="archimate:ApplicationComponent" name="Aplicación de gestión de medicamentos (solución)" id="id-a010ad7f240e44c1a32daebf38643cfd"/>
    <element xsi:type="archimate:ApplicationService" name="Predicción de demanda" id="id-6977c28b6edc434db07a2ed34bdd7ddf">
      <documentation>Realiza la capacidad naranja Predicción y planificación de la demanda (V2) y el requerimiento RE-04 (V1).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Generación de requerimientos de compra" id="id-0f32d2ad374a4c87950ae633a7cfd13b">
      <documentation>Realiza la capacidad naranja Generación de requerimientos de compra (V2) y RE-05 (V1). Solo genera el requerimiento; la cotización, la orden y el pago son externos (CO-03).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Gestión de inventario por lote y vencimiento" id="id-a7c418feaf994ae08e8be0a4e813d2f9">
      <documentation>Realiza la capacidad naranja Gestión de inventario por lote y vencimiento (V2) y RE-01 (V1); aplica PR-01.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Alertas y priorización FEFO de vencimientos" id="id-6b124d49d8ad466fae9bfff9f09bfa82">
      <documentation>Realiza la capacidad naranja Alertas de vencimiento y priorización FEFO (V2) y RE-02 y RE-03 (V1); aplica PR-02. Solo considera lotes aptos: excluye los lotes en cuarentena, retirados o vencidos.</documentation>
    </element>
  </folder>

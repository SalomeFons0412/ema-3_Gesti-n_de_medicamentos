<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Farmacia" id="id-4f59adca30cf42efada4f2a51940e1d1" version="5.0.0">
  <folder name="Strategy" id="id-a1b2747a9cf44a6cac140d198a882ddf" type="strategy">
    <element xsi:type="archimate:ValueStream" name="Gestión de medicamentos hospitalarios" id="id-4d01ec4584bb4b0490725d56617fa783">
      <documentation>Contribuye a las metas de la V1: GO-01 (reducir pérdidas por vencimiento), GO-02 (disponibilidad), GO-03 (anticipar el abastecimiento) y GO-04 (trazabilidad del inventario).</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Planificar la demanda" id="id-6db370a260ce45f1876fc916df70b94f">
      <documentation>Corresponde a la agrupación Planificación y selección de la V2.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Abastecer" id="id-49577bf7444c4d0ba07777f3a9807f1a">
      <documentation>Corresponde a la agrupación Abastecimiento de la V2.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Almacenar y controlar el inventario" id="id-0364017c9fde48e59be68e920b4458e2">
      <documentation>Corresponde a la agrupación Inventario y almacenamiento de la V2.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Dispensar y distribuir" id="id-d8571f57d78d448fbb31ac53c34f2449">
      <documentation>Corresponde a la agrupación Dispensación y uso de la V2.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Conciliar y controlar" id="id-4d1f6ccf46e049c884a8f941c4dc8bf4">
      <documentation>Corresponde a Control y vigilancia y a Conciliación y devoluciones de la V2.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Dirección y Gobierno Institucional" id="id-2693d417eb1d4e539a9101891fdf77e1"/>
    <element xsi:type="archimate:Capability" name="Planeación estratégica institucional" id="id-19bac33ff9c740f7a7349f878f5df8e5"/>
    <element xsi:type="archimate:Capability" name="Gestión financiera y presupuestal" id="id-790dcf99ca884436b507c91a3f1e9ac8"/>
    <element xsi:type="archimate:Capability" name="Gestión de calidad y seguridad del paciente" id="id-f02b5aa8e6eb4ae9818b4124122f1249"/>
    <element xsi:type="archimate:Capability" name="Gestión del talento humano" id="id-f82c022a761349a09b78b14465b835a0"/>
    <element xsi:type="archimate:Capability" name="Gestión legal y regulatoria" id="id-5fac3e0468de4a0e848ac604b524825b"/>
    <element xsi:type="archimate:Capability" name="Atención Clínica Asistencial" id="id-dc6cd603beee4214978948ea7875df86"/>
    <element xsi:type="archimate:Capability" name="Programación quirúrgica" id="id-d5e12b33c61b423494907a88a479c1ee">
      <documentation>Fuente de la demanda programada (CO-02, RE-04). Dependencia de otros sistemas (AS-04).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Atención de urgencias" id="id-649c624948674c1fb9cff6fb54c2bce7">
      <documentation>Origen de la demanda no programada (CO-02). Dependencia de otros sistemas (AS-04).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Cirugía y procedimientos" id="id-67db24eef96243e2ac3b8012fe00172d"/>
    <element xsi:type="archimate:Capability" name="Hospitalización y UCI" id="id-814a37c76e9f49ecadcdfe22fd2d293b"/>
    <element xsi:type="archimate:Capability" name="Historia clínica y prescripción" id="id-fdf596215b2e4d86bd168a810e48a01d">
      <documentation>Fuente de órdenes y consumo (AS-04). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión Farmacéutica Hospitalaria" id="id-716b1b88e6024afda64cecca37360c77"/>
    <element xsi:type="archimate:Capability" name="Planificación y selección" id="id-30bbb3ae330a444b955cfaf0fdd1c189"/>
    <element xsi:type="archimate:Capability" name="Selección y portafolio de medicamentos" id="id-88e4285e0dfc4fc1b944398a0b3e8911"/>
    <element xsi:type="archimate:Capability" name="Predicción y planificación de la demanda" id="id-d4798f0fafb847dda721c4592fe5861a">
      <documentation>Realiza RE-04 (estimar la demanda con programación e histórico). Contribuye a GO-03 y OU-02. Restricción CO-02: considerar demanda programada y no programada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Abastecimiento" id="id-9dc6fd44188e476fbb17b45da7ccdae1"/>
    <element xsi:type="archimate:Capability" name="Generación de requerimientos de compra" id="id-9265131a82e54a77b887ccf55763c9d8">
      <documentation>Realiza RE-05. Contribuye a GO-02 y GO-03. Límite CO-03: cotización, orden de compra y pago quedan fuera del alcance de la solución.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Autorización técnica de pronósticos y compras" id="id-f2b91381e7214dd4a5b808d433cdf7e0">
      <documentation>Aplica PR-03: la recomendación automatizada se separa de la autorización de compra. La ejerce el Químico Farmacéutico (según la entrevista). Capacidad relacionada, no es funcionalidad central.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Recepción técnica de medicamentos" id="id-a788d74c41eb4a499949362e1caf46ca">
      <documentation>Captura lote y fecha de vencimiento que alimentan RE-01 (PR-01, GO-04). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Inventario y almacenamiento" id="id-d52d43523bee48f7b4dc16ef1a3351c1"/>
    <element xsi:type="archimate:Capability" name="Gestión de inventario por lote y vencimiento" id="id-d62c93725de54dec9832c77fa9f11dbc">
      <documentation>Realiza RE-01. Aplica PR-01. Contribuye a GO-04 y OU-03 (y a GO-01).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Alertas de vencimiento y priorización FEFO" id="id-68157104f4f64396825de550c6e444bb">
      <documentation>Realiza RE-02 y RE-03. Aplica PR-02. Contribuye a GO-01 y OU-01.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Almacenamiento y cadena de frío" id="id-3bd8b4fa5cde41ac992d49ffacf4ef5f"/>
    <element xsi:type="archimate:Capability" name="Gestión de bajas, averías y destrucción" id="id-a1fa53855cc64d948b2f1b92fd53127e">
      <documentation>Movimientos de salida por vencimiento o avería (GO-01, AS-03). Relacionada, sin ampliar el alcance.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Dispensación y uso" id="id-432e18e198f043fb8be4ad7e5a01b6d0"/>
    <element xsi:type="archimate:Capability" name="Validación farmacéutica de prescripciones" id="id-73c4aafc374941ca9d19cca926811caa"/>
    <element xsi:type="archimate:Capability" name="Preparación de canastas y dosis unitaria" id="id-fcb4e310816b4d7daec342c0c2d9ee90">
      <documentation>Debe usar los lotes según PR-02 (FEFO). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Dispensación y reposición de stocks de piso" id="id-678617be50a644a482f06dd69a29b082">
      <documentation>Consume inventario por lote (PR-02) y atiende demanda no programada (CO-02). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Conciliación y devoluciones" id="id-71be9896884a4f31a7ed6d5a5fd49af6">
      <documentation>Reintegra existencias al inventario; relacionada con AS-03 (diferencias entre inventario físico y registrado).</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Control y vigilancia" id="id-82347d00679240588783822952346f90"/>
    <element xsi:type="archimate:Capability" name="Control de medicamentos de control especial" id="id-675bd35c6c5c45b7bae2db0de2a9f02a"/>
    <element xsi:type="archimate:Capability" name="Farmacovigilancia y bloqueo de lotes" id="id-f69bf0efeaa64175af5257b380a2b562">
      <documentation>El estado bloqueado o en cuarentena de un lote afecta las existencias utilizables (OU-03, PR-01). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Reportes regulatorios" id="id-a2c8f626323145f8b807dea3a76227cd"/>
    <element xsi:type="archimate:Capability" name="Soporte Administrativo y Logístico" id="id-e3ff1489953d4ee5a9d538c20b9131c9"/>
    <element xsi:type="archimate:Capability" name="Compras y gestión de proveedores" id="id-7cac575c0a3a4c5e97520f1df1782b38">
      <documentation>ST-03. Recibe el requerimiento generado (RE-05); CO-03 deja su gestión fuera del alcance.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Contabilidad y conciliación" id="id-1fc0a9115d4548798397522d0c908ca5">
      <documentation>ST-05. Autoriza ajustes y bajas de inventario (AS-03). Relacionada.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Facturación a aseguradoras" id="id-2ede21fcd10c4b9fbcc54506c2d78740"/>
    <element xsi:type="archimate:Capability" name="Gestión de tecnología (TI)" id="id-8e436c3aeb80421f80b0267e1e8767b3"/>
    <element xsi:type="archimate:Capability" name="Almacén y logística general" id="id-de727adfeea14231aaf981c687727260"/>
  </folder>
  <folder name="Business" id="id-d9078c20e2f040e38e17a15d1feaabfb" type="business">

    <element xsi:type="archimate:BusinessObject" name="Movimiento de inventario (copy)" id="id-60fa6255d0724f4bb738b949310a4d22"/>
    <element xsi:type="archimate:BusinessObject" name="Consumo histórico" id="id-81ce6711391b4f9f9e41c90a6a84b604"/>
    <element xsi:type="archimate:BusinessObject" name="Programación hospitalaria" id="id-a1e5d896462e446e825f73710276fb2d"/>
    <element xsi:type="archimate:BusinessObject" name="Predicción de demanda" id="id-64f5d19b8ede486ea90293bc63f06158"/>
    <element xsi:type="archimate:BusinessObject" name="Necesidad estimada de medicamentos" id="id-6836fccd38354b44b9ed2695c4bba3df"/>
    <element xsi:type="archimate:BusinessObject" name="Requerimiento de compra" id="id-c0f8eeadc15a43f883af04f6e585c051"/>
    <element xsi:type="archimate:BusinessObject" name="Cantidad requerida" id="id-090d528b81434475a6c737b8b68aa8f0"/>
    <element xsi:type="archimate:BusinessObject" name="Autorización técnica" id="id-ad556a80f9ba4096ac1ab4af7eecd091"/>
    <element xsi:type="archimate:BusinessObject" name="Estado del abastecimiento" id="id-7f35c50e97ac44be82a53c524473d646"/>
    <element xsi:type="archimate:BusinessRole" name="Contexto de ejecución que aplica las reglas de vencimiento y priorización, genera alertas y valida si los lotes cumplen las condiciones para su utilización." id="id-ad5b9c6dcc0546459376aae2843e5d03"/>
    <element xsi:type="archimate:BusinessActor" name="Entidad de vigilancia farmaceutica (externa)" id="id-16311058fdff40fbba2c37f80d02897c"/>
    <element xsi:type="archimate:Representation" name="FEFO" id="id-eef169db8a904a1e82ca222121eeebf9"/>
    <element xsi:type="archimate:Representation" name="Lote apto" id="id-adf4727cd6ef407e997a268cef2a1817"/>
    <element xsi:type="archimate:Representation" name="Lote crítico" id="id-daa378e7f2a44e049e8d97afd9cd317d"/>
    <element xsi:type="archimate:Representation" name="Umbral de alerta" id="id-11275abc84614adb820bb3266b4c6ecb"/>
    <element xsi:type="archimate:Representation" name="Restricción de uso" id="id-08f4cce99863489d8688d79f9a99f10f"/>
    <element xsi:type="archimate:BusinessProcess" name="Proceso de dispensación" id="id-35610a8ab46d448db2d300c427832388"/>
    <element xsi:type="archimate:BusinessProcess" name="Proceso de dispensación" id="id-cb88322768a145dea972495f5874b1bf"/>
    <element xsi:type="archimate:Representation" name="Término: FEFO" id="id-d0c502c12c424d9f9d43aa73e8094193"/>
    <element xsi:type="archimate:Representation" name="Término: Cuarentena" id="id-f5ef38b3a6ca4ec08b11c359f78a1673"/>
    <element xsi:type="archimate:Representation" name="Término: Dosis Unitaria" id="id-2b5a764b0faa4206812797103efb2965"/>
    <element xsi:type="archimate:Representation" name="Término: Recepción Técnica" id="id-274cb6a832d0489ba8d160417aebefcc"/>
    <element xsi:type="archimate:Representation" name="Término: Canasta Quirúrgica" id="id-2c27e831d6db44f7b9e3ece6d7e8b138"/>
    <element xsi:type="archimate:BusinessProcess" name="Proceso E2E: Gestión de medicamentos hospitalarios (demanda programada y no programada)" id="id-6ecee34eec5a4c46b22bbf6b99d9b703">
      <documentation>Considera la demanda programada y la no programada (V1: CO-02). La aplicación sirve solo a las actividades que dependen de las cuatro capacidades naranja de la V2.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Área de programación quirúrgica" id="id-de2a835379b94f538ef9547b8e5bc8eb">
      <documentation>Área organizacional que publica la agenda quirúrgica. El sistema de programación quirúrgica, como sistema externo, se modelará en la V9 (interoperabilidad).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Agenda quirúrgica publicada (24 a 48 h antes)" id="id-1822d4714e7a4ba89ad8d7fef3b4a581">
      <documentation>Alimenta la estimación de la demanda: la programación quirúrgica define las necesidades previstas (V1: CO-02, RE-04).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Cirugía programada confirmada (alistamiento anticipado)" id="id-fcae059d359c4e25824c31b17ddd644f">
      <documentation>Entrevista: la agenda llega 24 a 48 h antes y el auxiliar inicia el alistamiento de la canasta. Es una dependencia directa de la preparación; la aprobación de salida depende de la verificación (A12), no de la programación (V1: CO-02).</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Regente de Farmacia" id="id-1a57b84ac3204e0baee37df59b247cc1">
      <documentation>Rol de la farmacia (interesado ST-02 de la V1). Coordina inventario y alertas de vencimiento.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Estimar la demanda con la programación y el histórico" id="id-b64a2c61ea474f93b40309933452d68b">
      <documentation>V1: RE-04 (estimar la demanda con programación e histórico); contribuye a GO-03 y OU-02. V2: Predicción y planificación de la demanda. Considera demanda programada y no programada (CO-02).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Generar el requerimiento de compra" id="id-d6635a4521ff4d2cb0fd43311e7d5928">
      <documentation>V1: RE-05; contribuye a GO-02 y GO-03. V2: Generación de requerimientos de compra. Es el límite de la solución en compras (CO-03).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Alerta de lote próximo a vencer" id="id-7537f4f19e2d4ddd80138b5f13714c3f">
      <documentation>V1: RE-02 (generar alertas de medicamentos próximos a vencer). Lo genera el servicio de alertas de la aplicación.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Priorizar el uso de los lotes aptos según vencimiento y demanda próxima (FEFO)" id="id-5bbdd4fd3dcf4b08a9407193676c46c3">
      <documentation>V1: RE-03 y PR-02; contribuye a GO-01 y OU-01. V2: Alertas de vencimiento y priorización FEFO. Opera solo sobre lotes aptos: A9 se resuelve antes (secuencia A9 → A8).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar bajas, averías y diferencias de inventario" id="id-4744d33f5214410ea6940db870ab569d">
      <documentation>V1: AS-03 y GO-01. V2: Gestión de bajas, averías y destrucción (capacidad relacionada, sin ampliar el alcance).</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Químico Farmacéutico (Director Técnico)" id="id-d0aafc5afc374b06a5f07a3451d56999">
      <documentation>Rol de la farmacia (ST-02). Responsable técnico y legal; autoriza pronósticos, compras, bajas y viabilidad de lotes.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Revisar y autorizar la predicción" id="id-1100e91f8d6a45b9b6b29b1596b0bec6">
      <documentation>V1: PR-03, la recomendación automatizada se separa de la autorización. La autoriza el Químico Farmacéutico (entrevista). V2: Autorización técnica de pronósticos y compras.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Autorizar técnicamente el requerimiento de compra" id="id-7dc93da466d7416895554305db732ede">
      <documentation>V1: PR-03. El Químico Farmacéutico revisa y autoriza el requerimiento antes de que pase a Compras. V2: Autorización técnica de pronósticos y compras.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Bloquear el lote en cuarentena y definir su viabilidad (queda excluido del FEFO)" id="id-7a4783bfa31845b4b28edf19115431a5">
      <documentation>Un lote bloqueado o en cuarentena no es elegible: sale de la priorización FEFO y del picking hasta que el Químico Farmacéutico lo declare apto (entrevista; V1: OU-03, PR-01).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Validar la prescripción médica (validación farmacológica)" id="id-b31fab1d81d048e192d7b9741e10215d">
      <documentation>Validación farmacológica de la prescripción: previa en hospitalización y retrospectiva en urgencias (entrevista).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Verificar la canasta o dosis contra la prescripción y aprobar la salida" id="id-aec7377033764501a768adc1c92d56d0">
      <documentation>Aprobación de la salida por el Regente o el Químico Farmacéutico (entrevista), según la prescripción y la disponibilidad.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Reportar a la entidad de vigilancia (control especial y eventos adversos)" id="id-b7bc5de08a2f4d30b6b5237040fa8443">
      <documentation>V2: Reportes regulatorios (capacidad de contexto). El experto indica que el sistema debe generar reportes exportables.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Entidad de vigilancia de medicamentos (ej. INVIMA)" id="id-59503151e4a54e78861cca1797be5439">
      <documentation>Actor externo regulador. Emite alertas de farmacovigilancia y recibe los reportes de control especial y eventos adversos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Alerta de farmacovigilancia (retiro de lote)" id="id-eae49fad79bd4becbefc60eba86d987b">
      <documentation>Alerta externa del ente de vigilancia (V2: Farmacovigilancia y bloqueo de lotes, capacidad relacionada).</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Auxiliar de Farmacia" id="id-89da90682ea8498e8bf99bc83116b256">
      <documentation>Rol de la farmacia (ST-02). Recibe, almacena, alista y entrega.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Realizar la recepción técnica (lote, vencimiento, registro sanitario)" id="id-a2352415f7bc492e85ffb503796574cd">
      <documentation>V1: PR-01. Captura el lote y la fecha de vencimiento que alimentan RE-01. V2: Recepción técnica de medicamentos (capacidad relacionada).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Ubicar y almacenar el lote (incluye cadena de frío)" id="id-ed6901efd01a4e218bbef369839c2722">
      <documentation>V1: RE-01 y PR-01; contribuye a GO-04. V2: Gestión de inventario por lote y vencimiento y Almacenamiento y cadena de frío.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Preparar canasta o dosis unitaria (picking FEFO solo con lotes aptos)" id="id-6441e71f9ef842cfb9c7db9760c13eef">
      <documentation>V1: PR-02 y RE-03. El picking toma el lote con vencimiento más próximo entre los lotes aptos (FEFO), según el sistema.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Entregar a quirófano, piso o urgencias" id="id-b063b7f053754d44bb08eb1e49155b4c">
      <documentation>Entrega al quirófano, a la farmacia satélite o al servicio.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Medicamento entregado al servicio" id="id-165718f6144043cb9718de8a9eca1b5d">
      <documentation>Punto de descargue de la existencia en el inventario.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Reintegrar sobrantes y recibir devoluciones" id="id-5a6a56537c614b04be6cf4aa40509d53">
      <documentation>V1: AS-03 (diferencias entre inventario físico y registrado). V2: Conciliación y devoluciones (capacidad relacionada).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Servicios asistenciales (médicos y enfermería)" id="id-a05ac0b1b5e942c09e49eb6b3443b3ec">
      <documentation>Interesado ST-04 de la V1. Prescribe, administra y registra el consumo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Prescripción médica registrada (hospitalización o urgencias)" id="id-36b52659b18e4b979e6cc10d9f3ed3d8">
      <documentation>Origen de la demanda no programada y de la hospitalización (V1: CO-02).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Administrar y registrar el consumo en la historia clínica" id="id-22e1b87d9ed4479a96384941acca78be">
      <documentation>Responsabilidad de los servicios asistenciales (V1: ST-04); el consumo registrado alimenta la historia clínica y el inventario.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Área de compras (Analista de Compras)" id="id-18ed7082db6c4998bd63eeedaf904c7d">
      <documentation>Interesado ST-03 de la V1. Ejecuta la cotización y la orden de compra, que están fuera del alcance de la solución (CO-03).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Cotizar y emitir la orden de compra (proceso externo)" id="id-710422067c2f408fb91342ed3e01f7db">
      <documentation>Proceso externo a la solución. V1: CO-03 (no se asume la gestión integral de compras) e interesado ST-03. Se muestra solo como parte del proceso hospitalario completo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Proveedor (laboratorio o distribuidor)" id="id-dfb836076cbb4e2a8c35dad0383ff771"/>
    <element xsi:type="archimate:BusinessEvent" name="Medicamento entregado por el proveedor" id="id-b5f688c49ba04b60a145b6948f30c690">
      <documentation>Entrega física del proveedor; da inicio a la recepción técnica.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Contabilidad y auditoría" id="id-0066eb35f41e4637a39feb9fc0d75832">
      <documentation>Interesado ST-05 de la V1. Concilia y autoriza los ajustes y bajas de inventario.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Conciliar el consumo y registrar bajas y ajustes (proceso externo)" id="id-52ae7fcb3e824e8d9f3ae3911224ee9b">
      <documentation>Proceso externo a la solución. V1: ST-05 y AS-03; autoriza los ajustes y bajas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Consumo conciliado y trazado" id="id-f952130ddae04fa5b7f09afdce70a38f">
      <documentation>Resultado operativo del E2E. La reducción de pérdidas por vencimiento es el resultado empresarial al que contribuye (V1: OU-01 y OU-03; metas GO-01 y GO-04); no forma parte del evento.</documentation>
    </element>
  </folder>
